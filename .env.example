# Kafka (depuis WSL = localhost, depuis container = kafka)
KAFKA_BROKER=localhost:9092

# Topics
TOPIC_NETWORK_EVENTS=network-events
TOPIC_MODEL_WEIGHTS=model-weights
TOPIC_GLOBAL_MODEL=global-model
TOPIC_ALERTS=alerts

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# API FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Capture réseau (interface WSL2)
CAPTURE_INTERFACE=eth0

# Federated Learning
FL_NUM_CLIENTS=3
FL_NUM_ROUNDS=10
FL_LOCAL_EPOCHS=5